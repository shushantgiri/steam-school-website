# ---------- Session signing (always required) --------------------------------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# ---------- Local mode (no Supabase): single-admin login ---------------------
# Generate both lines: npm run hash-password -- "your password"
ADMIN_EMAIL="admin@steamschool.edu.np"
ADMIN_PASSWORD_HASH=""

# ---------- Supabase mode (production): see SUPABASE_SETUP.md ----------------
# Setting these switches content, uploads and login to Supabase automatically.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SITE_URL=""
